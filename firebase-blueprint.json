{
  "entities": {
    "Todo": {
      "title": "Todo Item",
      "description": "Represents a todo item / quest in the arcade todo list.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The todo task text or quest description"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the task is completed"
        },
        "createdAt": {
          "type": "string",
          "description": "Display timestamp string"
        },
        "createdAtTimestamp": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds for sorting"
        }
      },
      "required": ["text", "completed", "createdAt"]
    }
  },
  "firestore": {
    "/todos/{todoId}": {
      "entity": "Todo",
      "description": "Collection of todos"
    }
  }
}
